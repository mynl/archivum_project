# === Python bytecode ===
__pycache__/
*.py[cod]
*$py.class

# === Virtual environments ===
venv/
.env/
.venv/

# === Editor and OS files ===
*.swp          # Vim swap files
file-database.sublime-project
file-database.sublime-workspace
Thumbs.db      # Windows

# === Jupyter / Quarto / Notebook junk ===
.ipynb_checkpoints/
*.nbconvert.*
*.qmd~

# === Logs and temp files ===
*.log
*.tmp
*.bak

# === Python packaging ===
*.egg-info/
dist/
build/
# the vendored PDF.js viewer ships a build/ directory of its own
!src/archivum/web/static/vendor/pdfjs/build/
.eggs/

# === docs ===
docs/_build

# === Test and coverage ===
.coverage
htmlcov/
.tox/
.pytest_cache/
.cache/

# === VSCode and PyCharm settings ===
.vscode/
.idea/

# === User config ===
*.env
*.toml.local
config.yaml
secrets.yaml

# === Data artifacts (optional) ===
data/
*.feather
*.sqlite
*.db

*.sublime-workspace
*.sublime-project

# === Rust ===
rust/pycomfy/target
/pending-papers
*.ipynb
/rustfuzz/target
/new-papers
# The user's scratch link (to a backed-up folder outside the repo). No trailing
# slash: git sees a symlink as a file, and /temp/ would not match it.
/temp
