@article{Dhaene2008,
abstract = {We consider the problem of determining appropriate solvency capital requirements for an insurance company or a financial institution. We demonstrate that the sub- additivity condition that is often imposed on solvency capital principles can lead to the undesirable situation where the shortfall risk increases by a merger. We propose to complement the subadditivity condition by a regulator's condition. We find that for an explicitly specified confidence level, the Value-at-Risk satisfies the regulator's condition and is the “most efficient” capital requirement in the sense that it min- imizes some reasonable cost function. Within the class of concave distortion risk measures, of which the elements, in contrast to the Value-at-Risk, exhibit the sub- additivity property, we find that, again for an explicitly specified confidence level, the Tail-Value-at-Risk is the optimal capital requirement satisfying the regulator's condition.},
author = {Dhaene, Jan and Laeven, Roger J. A. and Vanduffel, Steven and Darkiewicz, G. and Goovaerts, Marc J.},
doi = {10.1111/j.1539-6975.2008.00264.x},
file = {:C\:/Users/steve/MendeleyLibrary/Dhaene et al/2008 - Dhaene et al. - Can a coherent risk measure be too subadditive.pdf:pdf},
isbn = {0022-4367},
issn = {00224367},
journal = {Journal of Risk and Insurance},
keywords = {Goovaerts,Risk Measures,diversification,g21,g22,g31,jel-classification,risk measures,solvency capital requirements,subadditivity,tail-,value-at-risk},
mendeley-tags = {Goovaerts,Risk Measures},
number = {2},
pages = {365--386},
title = {{Can a coherent risk measure be too subadditive?}},
url = {http://onlinelibrary.wiley.com/doi/10.1111/j.1539-6975.2008.00264.x/full},
volume = {75},
year = {2008}
}
