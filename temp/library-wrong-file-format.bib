journal = {Insurance: Mathematics and Economics},
keywords = {CMM,Capital allocation,Cooperative games,Correlation order,Distorted probability,PMIR,Risk management,Tsanakas,capital allocation,cooperative games,correlation order,distorted probability,risk management},
