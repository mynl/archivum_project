}
@article{Carr2021a,
abstract = {We study an asset pricing model in which a Stochastic Discount Factor (SDF) and a growth process have independent increments and are affected by a common stochastic clock, which portraits uncertainty about jumps representing bonanzas and disasters. The stochastic clock is a strictly increasing process that includes a persistent component. The common component of the shock is meant to represent aggregated jumps, that is jumps whose drift it accumulating in time, like an integrated process. Skewness is positive if the rate of growth of bonanzas is greater than that of disasters. Positive skewness of the SDF is associated to negatively sloped zero-coupon bond term structure. For financial products whose cash flows are subject to the same stochastic clock the slope of the term structure is jointly determined by the difference between the skewness of the SDF and the covariance between the growth rate of the cash flows and of consumption (or the stochastic discount rate). Finally, the common component in the stochastic clock makes asset prices non-Markovian.},
author = {Carr, Peter and Cherubini, Umberto},
doi = {10.2139/ssrn.3995428},
file = {:C\:/Users/steve/MendeleyLibrary/Carr, Cherubini/2021 - Carr, Cherubini - Long Term Risk A Time Change Approach(2).pdf:pdf},
