@article{Segal1988,
abstract = {The article suggests a decision mechanism for the preference reversals lotteries, which is transitive and satisfies the independence axiom, but not the reduction axiom. One of the most puzzling paradoxes in decision theory is the preference reversal phenomenon. This phenomenon seems to contradict the transitivity axiom, for a long time, one of the cornerstones of utility theory. Such experiments, first reported by economists Harold Lindman, Sarah Lichtenstein and Paul Slovic, were later repeated by other economists. Although the later researchers improved the mechanism through which the selling price emerges, they all found systematic reversals. A new approach to this problem was developed by economist Charles Holt in 1986, and Edi Karni and Zvi Safra in 1987. From two different starting points, these authors showed that the preference reversal phenomenon does not necessarily prove a violation of the transitivity axiom, as it may contradict the independence axiom. This implies that people do not maximize expected utility, but in that case the preference reversal phenomenon becomes just another evidence against expected utility theory, but not against the transitivity axiom.},
author = {Segal, Uzi},
file = {:C\:/Users/steve/MendeleyLibrary/Segal/1988 - Segal - Does the preference reversal phenomenon necessarily contradict the independence axiom.pdf:pdf},
issn = {0002-8282},
journal = {American Economic Review},
number = {1},
pages = {233--236},
title = {{Does the preference reversal phenomenon necessarily contradict the independence axiom?}},
