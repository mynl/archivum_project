file = {:C\:/Users/steve/MendeleyLibrary/Bar-Lev, Letac/2010 - Bar-Lev, Letac - The limiting behavior of some infinitely divisible exponential dispersion models(2).pdf:pdf},
issn = {01677152},
journal = {Statistics and Probability Letters},
keywords = {EDM-GLM,Exponential dispersion model,Infinitely divisible distributions,Limiting distributions,Natural exponential family},
mendeley-tags = {EDM-GLM},
number = {23-24},
pages = {1870--1874},
title = {{The limiting behavior of some infinitely divisible exponential dispersion models}},
volume = {80},
year = {2010}
}
