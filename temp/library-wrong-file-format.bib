@article{Reingold2002,
abstract = {The main contribution is a new type of graph product, which we\ncall the zig-zag product. Taking a product of a large graph with a small\ngraph, the resulting graph inherits (roughly) its size from the large\none, its degree from the small one, and its expansion properties from\nboth. Iteration yields simple explicit constructions of constant-degree\nexpanders of every size, starting from one constant-size expander.\nCrucial to our intuition (and simple analysis) of the properties of this\ngraph product is the view of expanders as functions which act as\n&ldquo;entropy wave&rdquo; propagators-they transform probability\ndistributions in which entropy is concentrated in one area to\ndistributions where that concentration is dissipated. In these terms,\nthe graph product affords the constructive interference of two such\nwaves. A variant of this product can be applied to extractors, giving\nthe first explicit extractors whose seed length depends\n(poly)logarithmically on only the entropy deficiency of the source\n(rather than its length) and that extract almost all the entropy of high\nmin-entropy sources. These high min-entropy extractors have several\ninteresting applications, including the first constant-degree explicit\nexpanders which beat the &ldquo;eigenvalue bound&rdquo;},
archivePrefix = {arXiv},
arxivId = {math/0406038},
author = {Reingold, Omer and Vadhan, Salil and Wigderson, Avi},
doi = {10.1109/SFCS.2000.892006},
eprint = {0406038},
file = {:C\:/Users/steve/MendeleyLibrary/Reingold, Vadhan, Wigderson/2002 - Reingold, Vadhan, Wigderson - Entropy waves, the zig-zag graph product, and new constant-degree expanders.pdf:pdf},
isbn = {0-7695-0850-2},
issn = {0003486X},
journal = {Annals of Mathematics},
keywords = {Entropy,Expander graphs,Graph products},
number = {1},
pages = {157--187},
primaryClass = {math},
title = {{Entropy waves, the zig-zag graph product, and new constant-degree expanders}},
volume = {155},
year = {2002}
}
