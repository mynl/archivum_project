@article{Liu2022,
abstract = {Inspired by the recent developments in risk sharing problems for the value at risk (VaR), the expected shortfall (ES), and the range value at risk (RVaR), we study the optimization of risk sharing for general tail risk measures. Explicit formulas of the inf-convolution and Pareto-optimal allocations are obtained in the case of a mixed collection of left and right VaRs, and in that of a VaR and another tail risk measure. The inf-convolution of tail risk measures is shown to be a tail risk measure with an aggregated tail parameter, a phenomenon very similar to the cases of VaR, ES, and RVaR. Optimal allocations are obtained in the settings of elliptical models and model uncertainty. In particular, several results are established for tail risk measures in the presence of model uncertainty, which may be of independent interest outside the framework of risk sharing. The technical conclusions are quite general without assuming any form of convexity of the tail risk measures. Our analysis generalizes in several directions the recent literature on quantile-based risk sharing.},
author = {Liu, Fangda and Mao, Tiantian and Wang, Ruodu and Wei, Linxiao},
doi = {10.1287/moor.2021.1217},
file = {:C\:/Users/steve/MendeleyLibrary/Liu et al/2022 - Liu et al. - Inf-Convolution, Optimal Allocations, and Model Uncertainty for Tail Risk Measures.pdf:pdf},
issn = {15265471},
journal = {Mathematics of Operations Research},
keywords = {PMIR,Pareto optimality,Risk Sharing,WangR,nonconvex optimization,range value at risk,risk sharing,value at risk},
mendeley-tags = {PMIR,Risk Sharing,WangR},
number = {3},
pages = {2494--2519},
title = {{Inf-Convolution, Optimal Allocations, and Model Uncertainty for Tail Risk Measures}},
volume = {47},
year = {2022}
}
