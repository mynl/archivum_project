doi = {10.1111/1098-1616.00019},
file = {:C\:/Users/steve/MendeleyLibrary/Liebenberg, Hoyt/2003 - Liebenberg, Hoyt - The Determinants of Enterprise Risk Management Evidence From the Appointment of Chief Risk Officers.pdf:pdf},
