@article{Efron1978,
abstract = {There are two important spaces connected with every multivariate exponential family, the natural parameter space and the expectation parameter space. We describe some geometric results relating the two. (In the simplest case, that of a normal translation family, the two spaces coincide and the geometry is the familiar Euclidean one.) Maximum likelihood estimation, within one-parameter curved subfamilies of the multivariate family, has two simple and useful geometric interpretations. The geometry also relates to the Fisherian question: to what extent can the Fisher information be replaced by -∂2/∂$\theta$2[log f$\theta$(x)]∣$\theta$=$\theta$̂ in the variance bound for $\theta$̂, the maximum likelihood estimator?},
