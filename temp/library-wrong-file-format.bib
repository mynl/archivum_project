@article{Mikusinksi1959,
annote = {from scipy.integrate import quad 
from numpy import sin, exp, pi, sqrt


def F(t, a):
    def f(phi):
        s = sin(phi)
        sap = sin(a * phi)
        smap = sin((1-a)*phi)
        e = a/(1-a)
        u = t**(-e) * (sap/s)**e * (smap/s)
        return u * exp(-u)
    ans = quad(f, 0, pi)
    ansi = 1/pi * a/(1-a) / t * ans[0]
    return ansi, ans


def levy(t):
    return 1/sqrt(4*pi*t**3) * exp(-1/(4*t))


print(F(10., .5), levy(10.))},
