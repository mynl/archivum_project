issn = {01676687},
journal = {Insurance: Mathematics and Economics},
keywords = {Ceded loss function,Conditional tail expectation (CTE),Convex analysis,Directional derivative,Expectation premium principle,Lagrangian method,Optimal reinsurance,Subdifferential},
number = {2},
pages = {175--187},
publisher = {Elsevier B.V.},
title = {{Optimality of general reinsurance contracts under CTE risk measure}},
