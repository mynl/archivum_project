@article{Gylys,
abstract = {The primary objective of this work is to analyze Value-at-Risk associated with mortality 1 risk arising from issued term life assurance contracts and to compare the results with the capital 2 requirements for mortality risk as determined using Solvency II Standard Formula. In particular, 3 two approaches to calculation of Value-at-Risk are analyzed: one-year VaR and runoff VaR. The 4 calculations of Value-at-Risk are performed using stochastically simulated mortality rates which are 5 calibrated using the Lee-Carter model fitted using mortality data of selected European countries. The 6 results indicate that, depending on the approach taken to calculate Value-at-Risk, the key factors 7 driving its relative size are: sensitivity of technical provisions to the latest mortality experience, 8 volatility of mortality rates in a country, policy term and benefit formula. Overall, we found that 9 Solvency II Standard Formula on average delivers an adequate capital requirement, however, we also 10 highlight particular situations where it could understate or overstate portfolio specific Value-at-Risk 11 for mortality risk. 12},
author = {Gylys, Rokas and {\v{S}}iaulys, Jonas},
file = {:C\:/Users/steve/MendeleyLibrary/Gylys, {\v{S}}iaulys/Unknown - Gylys, {\v{S}}iaulys - Revisiting Calibration of the Solvency II Standard Formula for Mortality Risk does the Standard Stress Scenar.pdf:pdf},
journal = {Risks - REVIEW},
keywords = {Lee-Carter,Reviewed,Solvency Capital 13,Solvency II,Value-at-Risk,mortality risk,standard formula},
mendeley-tags = {Reviewed},
title = {{Revisiting Calibration of the Solvency II Standard Formula for Mortality Risk: does the Standard Stress Scenario Provide an Adequate Approximation of Value-at-Risk?}},
url = {www.mdpi.com/journal/notspecified}
}
