journal = {Journal of Banking and Finance},
keywords = {Auto insurance,Regulation,Regulatory incentives,Revolving door},
number = {1},
pages = {116--133},
title = {{Regulator performance, regulatory environment and outcomes: An examination of insurance regulator career incentives on state insurance markets}},
volume = {32},
year = {2008}
}
