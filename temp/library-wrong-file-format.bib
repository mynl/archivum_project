keywords = {2007,2008,CMM,accepted by michael fu,and conditional value at,applications,history,in advance september 5,portfolio,published online in articles,received august 19,risk,simulation,statistical analysis,stochastic models and simulation,this paper was,value at risk,var,weeks for 4 revisions,with the authors 3},
