title = {{Marginal Indemnification Function formulation for optimal reinsurance}},
volume = {67},
year = {2016}
}
@article{Sepanski2023,
abstract = {In this paper, we present a new method to construct new classes of distortion functions. A distortion function maps the unit interval to the unit interval and has the characteristics of a cumulative distribution function. The method is based on the transformation of an existing non-negative random variable whose distribution function, named the generating distribution, may contain more than one parameter. The coherency of the resulting risk measures is ensured by restricting the parameter space on which the distortion function is concave. We studied cases when the generating distributions are exponentiated exponential and Gompertz distributions. Closed-form expressions for risk measures were derived for uniform, exponential, and Lomax losses. Numerical and graphical results are presented to examine the effects of the parameter values on the risk measures. We then propose a simple plug-in estimate of risk measures and conduct simulation studies to compare and demonstrate the performance of the proposed estimates. The plug-in estimates appear to perform slightly better than the well-known L-estimates, but also suffer from biases when applied to heavy-tailed losses.},
author = {Sepanski, Jungsywan H. and Wang, Xiwen},
doi = {10.3390/risks11110194},
file = {:C\:/Users/steve/MendeleyLibrary/Sepanski, Wang/2023 - Sepanski, Wang - New Classes of Distortion Risk Measures and Their Estimation.pdf:pdf},
issn = {22279091},
journal = {Risks},
keywords = {Gompertz distortion,Kumaraswamy distortion,L-estimator,coherent risk measure,distortion function,exponential–exponential distortion,plug-in estimator},
number = {11},
pages = {1--21},
title = {{New Classes of Distortion Risk Measures and Their Estimation}},
volume = {11},
year = {2023}
}
