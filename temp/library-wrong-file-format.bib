@article{Denuit2020f,
abstract = {The size-biased, or length-biased transform is known to be particularly useful in insurance risk measurement. The case of continuous losses has been extensively considered in the actuarial literature. Given their importance in insurance studies, this article concentrates on compound sums. The zero-augmented distributions that naturally appear in the individual model of risk theory are obtained as particular cases when the claim frequency distribution is concentrated on {0, 1}. The general results derived in this article help actuaries to understand how risk measurement proceeds because the formulas make explicit the loadings corresponding to each source of randomness. Some simple and explicit expressions are obtained when losses are modeled by independent compound Poisson sums and compound mixed Poisson sums, including the compound negative binomial sums. Extensions to correlated risks are briefly discussed in the concluding section.},
