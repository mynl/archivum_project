file = {:C\:/Users/steve/MendeleyLibrary/Kr{\"{a}}tschmer, Schied, Z{\"{a}}hle/2014 - Kr{\"{a}}tschmer, Schied, Z{\"{a}}hle - Comparative and qualitative robustness for law-invariant risk measures(2).pdf:pdf},
issn = {09492984},
journal = {Finance and Stochastics},
keywords = {Coherent risk measure,Comparative robustness,Convex risk measure,Distortion risk measure,Hampel's theorem,Index of qualitative robustness,Law-invariant risk measure,Orlicz space,Qualitative robustness,Skorohod representation,$\psi$-weak topology},
number = {2},
