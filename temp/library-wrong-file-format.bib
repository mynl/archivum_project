@article{Witt1973,
abstract = {Monopolistic competition models are used to analyze pricing and availability problems in the standard voluntary market for automobile liability insurance. The analysis suggests that both competition and restrictive rate regulation encourage selective underwriting which tends to cause availability problems for substandard risks. Moreover, it was found that there is no apparent economic justification for rate regulation when there is adequate competition in a market. Therefore, it is suggested that competition could be the primary regulator of rates in most states. If rate regulation were abandoned or if competitive rate regulatory laws were enacted in more states, the magnitude of the availability problem could probably be reduced substantially. The economic analysis also suggests that the current controversy about the direct inclusion of investment income in ratemaking formulas may be meaningless if competition tends to force insurers to consider such income indirectly in their pricing decisions. [ABSTRACT FROM AUTHOR]},
