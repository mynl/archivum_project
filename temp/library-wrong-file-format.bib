eprint = {arXiv:1403.2923v1},
file = {:C\:/Users/steve/MendeleyLibrary/Deerwester et al/1990 - Deerwester et al. - Indexing by Latent Semantic Analysis.pdf:pdf},
isbn = {9781450300322},
