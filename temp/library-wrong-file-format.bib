file = {:C\:/Users/steve/MendeleyLibrary/Bielecki, Cialenco, Liu/2023 - Bielecki, Cialenco, Liu - Time consistency of dynamic risk measures and dynamic performance measures generated by distortion func.pdf:pdf},
issn = {15324214},
journal = {Stochastic Models},
keywords = {Average value at risk,Choquet integral,MAXMINVAR,MAXVAR,MINMAXVAR,MINVAR,PMIR,distortion functions,dynamic acceptability indices,dynamic risk measures,low invariant risk measures,time consistency,weighted value at risk},
mendeley-tags = {PMIR},
title = {{Time consistency of dynamic risk measures and dynamic performance measures generated by distortion functions}},
url = {http://arxiv.org/abs/2309.02570},
year = {2024}
}
