@article{Brunnermeier2014,
abstract = {This paper develops a framework for measuring, allocating and managing systemic risk.$\backslash$nSystRisk, our measure of total systemic risk captures the a priori cost to society for providing$\backslash$ntail-risk insurance to the financial system. Our allocation principle distributes the total systemic$\backslash$nrisk among individual institutions according to their size-shifted marginal contributions. To$\backslash$ndescribe economic shocks and systemic feedback effects we propose a reduced form stochastic$\backslash$nmodel that can be calibrated to historical data. We also discuss systemic risk limits, systemic$\backslash$nrisk charges and a cap and trade system for systemic risk.},
