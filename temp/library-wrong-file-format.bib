doi = {10.1080/1351847X.2018.1514314},
file = {:C\:/Users/steve/MendeleyLibrary/Bohnert et al/2019 - Bohnert et al. - The drivers and value of enterprise risk management evidence from ERM ratings.pdf:pdf},
