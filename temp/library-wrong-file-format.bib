file = {:C\:/Users/steve/MendeleyLibrary/Rockafellar, Royset, Miranda/2014 - Rockafellar, Royset, Miranda - Superquantile regression with applications to buffered reliability, uncertainty quantification, an.pdf:pdf},
issn = {03772217},
journal = {European Journal of Operational Research},
keywords = {Buffered failure probability,Conditional value-at-risk,Generalized regression,Rockafellar,Stochastic programming,Superquantiles,Uncertainty quantification},
mendeley-tags = {Rockafellar},
