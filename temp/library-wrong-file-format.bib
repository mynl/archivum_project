file = {:C\:/Users/steve/MendeleyLibrary/M{\"{u}}ller, R{\"{u}}schendorf/2001 - M{\"{u}}ller, R{\"{u}}schendorf - On the optimal stopping values induced by general dependence structures.pdf:pdf},
issn = {00219002},
journal = {Journal of Applied Probability},
keywords = {Distributions with given marginals,Extension of Strassen's theorem,Maximal dependence,Optimal stopping,Stochastic ordering},
number = {3},
pages = {672--684},
title = {{On the optimal stopping values induced by general dependence structures}},
volume = {38},
year = {2001}
}
