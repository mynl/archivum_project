@article{Chi2011,
abstract = {In this paper, we study two classes of optimal reinsurance models by minimizing the total risk exposure of an insurer under the criteria of value at risk (VaR) and conditional value at risk (CVaR). We assume that the reinsurance premium is cal- culated according to the expected value principle. Using a much simpler approach (for example compared to that in Cai et al. (2008)), explicit solutions for the optimal reinsurance policies are derived over ceded loss functions with increasing degrees of generality. More precisely, we establish formally that under the VaR minimization model, (i) the stop-loss reinsurance is optimal among the class of increasing convex ceded loss functions; (ii) when the constraints on both ceded and retained loss func- tions are relaxed to increasing functions, the stop-loss reinsurance with an upper limit is shown to be optimal; (iii) and finally under the set of general increasing retained loss functions, the truncated stop-loss reinsurance is shown to be optimal. However, under CVaR risk measure, the stop-loss reinsurance is shown to be always optimal.},
author = {Chi, Yichun and Tan, Ken Seng},
doi = {10.2143/AST.41.2.2136986},
file = {:C\:/Users/steve/MendeleyLibrary/Chi, Tan/2011 - Chi, Tan - Optimal Reinsurance under VaR and CVaR risk measures a simplified approach.pdf:pdf},
issn = {05150361},
journal = {ASTIN Bulletin},
number = {2},
pages = {487--509},
title = {{Optimal Reinsurance under VaR and CVaR risk measures: a simplified approach}},
volume = {41},
year = {2011}
}
@inproceedings{Zheng1997,
abstract = {Secure and authenticated message delivery/storage is one of the\nmajor aims of computer and communication security research. The\ncurrent standard method to achieve this aim is ``(digital)\nsignature followed by encryption''. In this paper, we address a\nquestion on the cost of secure and authenticated message\ndelivery/storage, namely, whether it is possible to\ntransport/store messages of varying length in a secure and\nauthenticated way with an expense less than that required by\n``signature followed by encryption''. This question seems to\nhave never been addressed in the literature since the invention\nof public key cryptography. We then present a positive answer to\nthe question. In particular, we discover a new cryptographic\nprimitive termed as ``signcryption'' which simultaneously\nfulfills both the functions of digital signature and public key\nencryption in a logically single step, and with a cost\nsignificantly lower than that required by ``signature followed\nby encryption''. For typical security parameters for high level\nsecurity applications (size of public moduli = 1536 bits),\nsigncryption costs 50% (31%, respectively) less in computation\ntime and 85% (91%, respectively) less in message expansion\nthan does ``signature followed by encryption'' based on the\ndiscrete logarithm problem (factorization problem,\nrespectively).},
author = {Zheng, Ynliang},
booktitle = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
doi = {10.1007/BFb0052234},
file = {:C\:/Users/steve/MendeleyLibrary/Zheng/1997 - Zheng - Digital signcryption or how to achieve cost(Signature & Encryption) cost(signature) cost(encryption).pdf:pdf},
isbn = {3540633847},
issn = {16113349},
keywords = {Authentication,Digital signature,Encryption,Key distribution,Public key cryptography,Secure message delivery/storage,Security,Signcryption},
pages = {165--179},
title = {{Digital signcryption or how to achieve cost(Signature &: Encryption) << cost(signature) + cost(encryption)}},
volume = {1294},
year = {1997}
}
