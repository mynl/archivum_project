@article{Fels2024,
abstract = {I revisit the question of which motive underlies insurance demand. Three archetypical models of insurance demand based, respectively, on risk aversion, state-dependent utility and imperfectly divisible consumption, are presented. These models show that the common principle underlying insurance is not a risk transfer, but meeting a conditional need. In this way, insurance aligns the risk in one's nancial endowment with the risk in one's nancial needs. This extends the traditional view of insurance. I show how this extension greatly simplies the generalization of classic results. I also discuss how the novel denition has implications for our discipline's research agenda and policy advice. JEL Classication: D01, D81, G22},
