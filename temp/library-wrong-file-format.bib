issn = {01676687},
journal = {Insurance: Mathematics and Economics},
keywords = {Dual representation,Rearrangement inequalities,Risk Measures,Risk measures,Stochastic dominance},
mendeley-tags = {Risk Measures},
number = {2},
pages = {405--415},
title = {{The natural Banach space for version independent risk measures}},
volume = {53},
year = {2013}
}
