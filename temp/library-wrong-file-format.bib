@article{Tsanakas2008,
abstract = {A distortion-type risk measure is constructed, which evaluates the risk of any uncertain position in the context of a portfolio that contains that position and a fixed background risk. The risk measure can also be used to assess the performance of individual risks within a portfolio, allowing for the portfolio's re-balancing, an area where standard capital allocation methods fail. It is shown that the properties of the risk measure depart from those of coherent distortion measures. In particular, it is shown that the presence of background risk makes risk measurement sensitive to the scale and aggregation of risk. The case of risks following elliptical distributions is examined in more detail and precise characterisations of the risk measure's aggregation properties are obtained. {\textcopyright} 2007 Elsevier Ltd. All rights reserved.},
author = {Tsanakas, Andreas},
doi = {10.1016/j.insmatheco.2007.01.015},
file = {:C\:/Users/steve/MendeleyLibrary/Tsanakas/2008 - Tsanakas - Risk measurement in the presence of background risk.pdf:pdf},
issn = {01676687},
journal = {Insurance: Mathematics and Economics},
keywords = {Background risk,Capital allocation,Elliptical distributions,Portfolio management,Risk measures,Tsanakas},
mendeley-tags = {Tsanakas},
number = {2},
pages = {520--528},
title = {{Risk measurement in the presence of background risk}},
volume = {42},
year = {2008}
}
@article{Nisan1994,
abstract = {We present a simple new construction of a pseudorandom bit generator. It stretches a short string of truly random bits into a long string that looks random to any algorithm from a complexity class C (e.g., P, NC, PSPACE, {\ldots}) using an arbitrary function that is hard for C. This construction reveals an equivalence between the problem of proving lower bounds and the problem of generating good pseudorandom sequences. Our construction has many consequences. The most direct one is that efficient deterministic simulation of randomized algorithms is possible under much weaker assumptions than previously known. The efficiency of the simulations depends on the strength of the assumptions, and may achieve P = BPP. We believe that our results are very strong evidence that the gap between randomized and deterministic complexity is not large. Using the known lower bounds for constant depth circuits, our construction yields an unconditionally proven pseudorandom generator for constant depth circuits. As an application of this generator we characterize the power of NP with a random oracle. {\textcopyright} 1994 by Academic Press, Inc.},
author = {Nisan, Noam and Wigderson, Avi},
doi = {10.1016/S0022-0000(05)80043-1},
file = {::},
issn = {10902724},
journal = {Journal of Computer and System Sciences},
number = {2},
pages = {149--167},
title = {{Hardness vs randomness}},
volume = {49},
year = {1994}
}
