doi = {10.1016/j.insmatheco.2019.02.006},
file = {:C\:/Users/steve/MendeleyLibrary/Cheung, Yam, Zhang/2019 - Cheung, Yam, Zhang - Risk-adjusted Bowley reinsurance under distorted probabilities.pdf:pdf},
issn = {01676687},
journal = {Insurance: Mathematics and Economics},
keywords = {Bowley solution,Distortion risk measure,Equilibrium reinsurance strategy,General premium principle,Pricing density,Risk Sharing,Stackelberg equilibria,Tail Value-at-Risk,Value-at-Risk},
mendeley-tags = {Risk Sharing},
pages = {64--72},
publisher = {Elsevier B.V.},
title = {{Risk-adjusted Bowley reinsurance under distorted probabilities}},
