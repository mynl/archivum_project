@article{Wuthrich2011a,
abstract = {For solvency purposes insurance companies need to calculate so-called best-estimate reserves for outstanding loss liability cash flows and a corresponding risk margin for non-hedgeable insurance-technical risks in these cash flows. In actuarial practice, the calculation of the risk margin is often not based on a sound model but various simplified methods are used. In the present paper we properly define these notions and we introduce insurance-technical probability distortions. We describe how the latter can be used to calculate a risk margin for non-life insurance run-off liabilities in a mathematically consistent way. {\textcopyright} 2011, by Oldenbourg Wissenschaftsverlag, London EC1Y 8TZ, Germany. All rights reserved.},
