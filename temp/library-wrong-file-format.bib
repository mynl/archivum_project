issn = {16512030},
keywords = {Complete model,Core solution,Equilibrium,Moral hazard,Pareto optimality,Reinsurance model,Stock market},
number = {2},
pages = {73--128},
title = {{Perspectives of risk sharing}},
volume = {2002},
year = {2002}
}
