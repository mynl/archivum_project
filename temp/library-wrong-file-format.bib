journal = {Mathematical Finance},
keywords = {WangR,concentration aversion,dependence,portfolio selection,risk measures,tail event},
mendeley-tags = {WangR},
number = {3},
pages = {819--846},
title = {{Risk concentration and the mean-expected shortfall criterion}},
volume = {34},
year = {2024}
}
