@article{Mango2007,
abstract = {Organizations are struggling with how to best determine the market value of risk management strategies. One promising framework, which draws on techniques and concepts from actuarial science and financial economics, not only provides the ability to quantify market value but can also drive greater consistency in assessing risk-return tradeoffs across a range of risk management efforts. This model is called the de Finetti-Levy Asset Value of Optimized Risk, Equity and Dividends (FLAVORED) model. A particular novelty of this model is that the level of predictable revenue can be a function of the current level of capital. FLAVORED models provide a framework for calculating how risk management protects franchise value. By focusing on sources of franchise value, the approach outlined by the FLAVORED model provides a comprehensive method for assessing the impact of risk management initiatives.},
