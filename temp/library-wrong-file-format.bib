@article{Ho2018,
abstract = {It is a challenge to define an uncountable set of real numbers that is dense in the real line and whose complement is also uncountable and dense. In this article we specify, for any positive integer k, a partition of the real line into k + 1 sets that are uncountable and dense; moreover, every real number is a condensation point for each of these sets. We show that one of these sets has measure one when restricted to the unit interval, while each of the others has measure zero. We then define a function that is continuous on the set of measure 1 but discontinuous elsewhere.},
