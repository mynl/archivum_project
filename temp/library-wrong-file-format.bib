issn = {1350-7265},
journal = {Bernoulli},
keywords = {black,importance sampling,importance sampling, Laplace's method, Monte Carlo,laplace,monte carlo method,multidimensional,multidimensional log-normal distribution,risk management,s method,scholes model,stress,tail-behavior,testing},
number = {1},
