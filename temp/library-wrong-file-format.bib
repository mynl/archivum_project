journal = {Journal of Derivatives},
keywords = {Carr,Peters,alessandro sgarabottolo,carol alexander,dynamics,growth optimal portfolio,kelly crierion,pasquale cirillo,pietro rossi,sid browne,speculative price,stephan sturm,stochastic clock models,the authors would like,to thank,violetta piperigou,without implicating},
