@article{Hinck2023,
abstract = {We analyze insurance demand when insurable losses come with an uninsurable zero-mean background risk that increases in the loss size. If the individual is risk vulnerable, loss-dependent background risk triggers a precautionary insurance motive and increases optimal insurance demand. Prudence alone is sufficient for insurance demand to increase in two cases: the case of fair insurance and the case where the smallest possible loss exceeds a certain threshold value (referred to as the large loss case). We derive conditions under which insurance demand increases or decreases in initial wealth. In the large loss case, prudence determines whether changes in the background risk lead to more insurance demand. We generalize this result to arbitrary loss distributions and find conditions based on decreasing third-degree Ross risk aversion, Arrow–Pratt risk aversion, and Arrow–Pratt temperance.},
author = {Hinck, Sebastian and Steinorth, Petra},
doi = {10.1111/jori.12426},
file = {:C\:/Users/steve/MendeleyLibrary/Hinck, Steinorth/2023 - Hinck, Steinorth - Insurance demand in the presence of loss-dependent background risk.pdf:pdf},
issn = {15396975},
journal = {Journal of Risk and Insurance},
keywords = {JRI2023,background risk,insurance demand,loss-dependent background risk,prudence,risk vulnerability},
mendeley-tags = {JRI2023},
number = {4},
pages = {991--1026},
title = {{Insurance demand in the presence of loss-dependent background risk}},
volume = {90},
year = {2023}
}
@article{Smith1976,
abstract = {Economist Adam Smith's (1723-1790) doctrine was that work, services, and goods are valued in varying degrees by the supply and demand of each service or good, as determined in a totally free, open marketplace. Often, the long-term result is an inequality between the unorganized demanders as consumers and a concentrated supplier now functioning as an oligopoly. Albert Schweitzer (1875-1965) founded a hospital, surgical clinic, and a haven for those afflicted with leprosy in Gabon, Africa. Adam Smith and his unbridled "free enterprise" represent an extreme of the exploitation man by his fellow man. If that is the current human trait, then Schweitzer represents the higher human level antithesis, man's superb conscientiousness of the state of his fellow man. Somewhere between Adam Smith and Albert Schweitzer lies the path for human health care.},
author = {Smith, Adam},
doi = {10.1057/9780230291652},
file = {:C\:/Users/steve/MendeleyLibrary/Smith/1976 - Smith - An Inquiry into the Nature and the Causes of the Wealth of Nations.pdf:pdf},
isbn = {9780521770590},
issn = {10786767},
journal = {The Glasgow Edition of the Works and Correspondence of Adam Smith},
pages = {1--743},
