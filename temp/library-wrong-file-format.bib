eprint = {2409.05103},
file = {:C\:/Users/steve/MendeleyLibrary/Ghossoub, Zhu, Chong/2024 - Ghossoub, Zhu, Chong - Pareto-Optimal Peer-to-Peer Risk Sharing with Robust Distortion Risk Measures.pdf:pdf},
keywords = {PMIR,Risk Sharing},
