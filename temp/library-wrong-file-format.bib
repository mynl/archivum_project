journal = {Insurance: Mathematics and Economics},
keywords = {Concave order,Directional lower coupling,Risk aggregation,Risk measures,Value-at-Risk,WangR},
mendeley-tags = {WangR},
pages = {169--187},
title = {{Risk aggregation under dependence uncertainty and an order constraint}},
volume = {102},
year = {2022}
