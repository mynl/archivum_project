@article{Pichler2015a,
abstract = {This paper prices insurance contracts by employing law invariant, coherent risk measures from mathematical finance. We demonstrate that the corresponding premium principle enjoys a minimal representation. Uniqueness-in a sense specified in the paper-of this premium principle is derived from this initial result. The representations are derived from a result by Kusuoka, which is usually given for nonatomic probability spaces. We extend this setting to premium principles for spaces with atoms, as this is of particular importance for insurance.Further, stochastic order relations are employed to identify the minimal representation. It is shown that the premium principles in the minimal representation are extremal with respect to the order relations. The tools are finally employed to explicitly provide the minimal representation for premium principles, which are important in actuarial practice.},
