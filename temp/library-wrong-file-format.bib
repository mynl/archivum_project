@article{Backhoff-Veraguas2020,
abstract = {In classical optimal transport, the contributions of Benamou–Brenier and McCann regarding the time-dependent version of the problem are cornerstones of the field and form the basis for a variety of applications in other mathematical areas. We suggest a Benamou–Brenier type formulation of the martingale transport problem for given d-dimensional distributions $\mu$, $\nu$ in convex order. The unique solution M* = (M* t )t&#8714;[0,1] of this problem turns out to be a Markovmartingale which has several notable properties: In a specific sense it mimics the movement of a Brownian particle as closely as possible subject to the conditions M*0 $\sim$$\mu$, M*1m $\sim$$\nu$. Similar to McCann's displacement-interpolation, M* provides a time-consistent interpolation between $\mu$ and $\nu$. For particular choices of the initial and terminal law, M* recovers archetypical martingales such as Brownian motion, geometric Brownian motion, and the Bass martingale. Furthermore, it yields a natural approximation to the local vol model and a new approach to Kellerer's theorem. This article is parallel to the work of Huesmann–Trevisan, who consider a related class of problems from a PDE-oriented perspective.},
archivePrefix = {arXiv},
arxivId = {1708.04869},
author = {Backhoff-Veraguas, Julio and Beiglb{\"{o}}ck, Mathias and Huesmann, Martin and K{\"{a}}llblad, Sigrid},
doi = {10.1214/20-AOP1422},
eprint = {1708.04869},
file = {::},
issn = {2168894X},
journal = {Annals of Probability},
keywords = {Beiglb{\"{o}}ck,Benamou–brenier,Brenier's theorem,Causal transport,Cyclical monotonicity,Knothe rosenblatt coupling,Martingales,Optimal transport,Schr{\"{o}}dinger problem.,Weak transport problems},
mendeley-tags = {Beiglb{\"{o}}ck},
number = {5},
pages = {2258--2289},
title = {{Martingale Benamou–Brenier: a Probabilistic Perspective}},
volume = {48},
year = {2020}
}
