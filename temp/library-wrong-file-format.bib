@article{Asmussen1996,
abstract = {Consider a random walk or L{\'{e}}vy process {St} and let $\tau$(u) = inf {t ≥ 0:St > u}, ℙ(u)({\textperiodcentered}) = ℙ({\textperiodcentered} | $\tau$(u) < ∞). Assuming that the upwards jumps are heavy-tailed, say subexponential (e.g. Pareto, Weibull or lognormal), the asymptotic form of the ℙ(u)-distribution of the process {St} up to time $\tau$(u) is described as u → ∞. Essentially, the results confirm the folklore that level crossing occurs as result of one big jump. Particular sharp conclusions are obtained for downwards skip-free processes like the classical compound Poisson insurance risk process where the formulation is in terms of total variation convergence. The ideas of the proof involve excursions and path decompositions for Markov processes. As a corollary, it follows that for some deterministic function a(u), the limiting ℙ(u)-distribution of $\tau$(u)/a(u) is either Pareto or exponential, and corresponding approximations for the finite time ruin probabilities are given.},
author = {Asmussen, S{\o}ren and Kl{\"{u}}ppelberg, Claudia},
doi = {10.1016/S0304-4149(96)00087-7},
file = {:C\:/Users/steve/MendeleyLibrary/Asmussen, Kl{\"{u}}ppelberg/1996 - Asmussen, Kl{\"{u}}ppelberg - Large deviations results for subexponential tails, with applications to insurance risk.pdf:pdf},
issn = {03044149},
journal = {Stochastic Processes and their Applications},
keywords = {Conditioned limit theorem,Downwards skip-free process,Excursion,Extreme value theory,Insurance risk,Integrated tail,Maximum domain of attraction,Path decomposition,Random walk,Regular variation,Ruin probability,Subexponential distribution},
number = {1},
pages = {103--125},
title = {{Large deviations results for subexponential tails, with applications to insurance risk}},
volume = {64},
year = {1996}
}
