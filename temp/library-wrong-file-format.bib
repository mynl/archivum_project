@article{Jewitt1989,
abstract = {Expected utility maximizers are considered selecting from a family of risky prospects, and the way choice is affected by the decision makers' attitude to risk is investigated.  If the family of risky prospects can be ordered so that decision makers choose a gamble higher in the ordering -- as they are more risk tolerant -- it is natural to state that the family of risky prospects admits a comparative static result.  Comparative static results of this type are characterized.  The conditions can be seen as characterizing riskier distributions in a way different from Rothschild-Stiglitz (1970).  The requirement that the means of the different variables be equal is eliminated.  This appears to be a natural framework for analyzing risk taking in an entrepreneurial manner where more risk and higher gains accompany one another.  Defining a criterion of riskiness that is independent of location is one special case.},
author = {Jewitt, Ian},
doi = {10.1287/mnsc.35.1.60},
file = {:C\:/Users/steve/MendeleyLibrary/Jewitt/1989 - Jewitt - Choosing Between Risky Prospects The Characterization of Comparative Statics Results, and Location Independent Risk.pdf:pdf},
