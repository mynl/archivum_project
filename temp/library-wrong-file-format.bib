@article{Bar-Lev2010a,
abstract = {Consider an exponential dispersion model (EDM) generated by a probability $\mu$ on [0,∞) which is infinitely divisible with an unbounded L{\'{e}}vy measure v. The J{\o}rgensen set (i.e., the dispersion parameter space) is then R+, in which case the EDM is characterized by two parameters: $\theta$0, the natural parameter of the associated natural exponential family, and the J{\o}rgensen (or dispersion) parameter, t. Denote the corresponding distribution by EDM($\theta$0,t) and let Yt be a r.v. with distribution EDM($\theta$0,t). Then for v((x,∞))$\sim$-ℓlogx around zero, we prove that the limiting law F0 of Yt-t as t→0 is a Pareto type law (not depending on $\theta$0) with the form F0(u)=0 for u<1 and the form 1-u-ℓ for u≥1. This result enables an approximation of the distribution of Yt to be found for relatively small values of the dispersion parameter of the corresponding EDM. Illustrative examples are provided. {\textcopyright} 2010 Elsevier B.V.},
author = {Bar-Lev, Shaul K. and Letac, G{\'{e}}rard},
doi = {10.1016/j.spl.2010.08.013},
file = {:C\:/Users/steve/MendeleyLibrary/Bar-Lev, Letac/2010 - Bar-Lev, Letac - The limiting behavior of some infinitely divisible exponential dispersion models.pdf:pdf},
issn = {01677152},
journal = {Statistics and Probability Letters},
keywords = {EDM-GLM,Exponential dispersion model,Infinitely divisible distributions,Limiting distributions,Natural exponential family},
mendeley-tags = {EDM-GLM},
number = {23-24},
pages = {1870--1874},
publisher = {Elsevier B.V.},
title = {{The limiting behavior of some infinitely divisible exponential dispersion models}},
url = {http://dx.doi.org/10.1016/j.spl.2010.08.013},
volume = {80},
year = {2010}
}
