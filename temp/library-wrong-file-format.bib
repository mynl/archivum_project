@article{Zimmerman2019,
abstract = {A recent paper showed that given any positive integer k, the real line can be partitioned into k subsets, each of which is uncountable in every nonempty open interval in the real line. This article extends that result to show that the real line can be partitioned into an uncountable collection of such subsets, all but one of which have measure zero. This seems to be of interest in its own right since most of the well-known sets of measure zero are either countable or not dense. It is then shown that each of the sets in the partition can be partitioned further into an uncountable collection of subsets that are again uncountable in every nonempty open set of the real line. Indeed, this process can be repeated infinitely many times. Finally, all of the results for the real line are shown to extend to n-dimensional Euclidean spaces and to the classical lp spaces.},
author = {Zimmerman, Seth and Ho, Chungwu},
doi = {10.1080/00029890.2019.1640529},
file = {:C\:/Users/steve/MendeleyLibrary/Zimmerman, Ho/2019 - Zimmerman, Ho - Partitioning the Real Line into an Uncountable Collection of Everywhere Uncountably Dense Sets.pdf:pdf},
issn = {19300972},
journal = {American Mathematical Monthly},
keywords = {03E15,MSC: Primary 28H05,Secondary 26A03},
number = {9},
pages = {825--834},
title = {{Partitioning the Real Line into an Uncountable Collection of Everywhere Uncountably Dense Sets}},
volume = {126},
year = {2019}
}
@article{Ghossoub2019,
abstract = {In a problem of Pareto-efficient insurance contracting (bilateral risk sharing) with expected-utility preferences, Gollier (1987) relaxes the nonnegativity constraint on indemnities and argues that the existence of a deductible is only due to the variability in the cost of insurance, not the nonnegativity constraint itself. In this paper, we find support for a similar statement in problems of budget-constrained optimal insurance (i.e., demand for insurance). Specifically, we consider a setting of ambiguity (unilateral and bilateral) and a setting of belief heterogeneity. We drop the nonnegativity constraint and assume no cost (or a fixed cost) to the insurer, and we derive closed-form solutions to the problems that we formulate. In particular, we show that optimal indemnities no longer include a deductible provision; and they can be negative for small values of the loss, or in case of no loss.},
author = {Ghossoub, Mario},
doi = {10.1016/j.insmatheco.2018.10.004},
file = {:C\:/Users/steve/MendeleyLibrary/Ghossoub/2019 - Ghossoub - Budget-constrained optimal insurance without the nonnegativity constraint on indemnities.pdf:pdf},
issn = {01676687},
journal = {Insurance: Mathematics and Economics},
keywords = {Ambiguity,Choquet integral,Deductible contract,Ghossoub,Knightian uncertainty,Non-additive probability,Nonnegativity constraint,Optimal insurance,Probability distortion},
mendeley-tags = {Ghossoub},
pages = {22--39},
publisher = {Elsevier B.V.},
title = {{Budget-constrained optimal insurance without the nonnegativity constraint on indemnities}},
url = {https://doi.org/10.1016/j.insmatheco.2018.10.004},
volume = {84},
year = {2019}
}
