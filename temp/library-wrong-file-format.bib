issn = {0717-6163},
journal = {NBER Working Paper},
keywords = {Inequality, Labor Share, Elasticity of Substitutio,albert l,and investment at the,at the peterson institute,author,elasticity of substitution,for international economics and,harvard kennedy school,helpful discussion,i am grateful to,inequality,johannes weiss,labor share,labor-augmenting technical change,lawrence is senior fellow,pol antras for extremely,professor of international trade,robert z,ruiqing cao,s note,to duan duan,williams},
