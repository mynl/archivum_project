journal = {Nature Geoscience},
number = {2},
pages = {126--130},
publisher = {Nature Publishing Group},
title = {{Frequency and magnitude of volcanic eruptions controlled by magma injection and buoyancy}},
url = {http://www.nature.com/ngeo/journal/v7/n2/full/ngeo2041.html%5Cnhttp://www.nature.com/ngeo/journal/v7/n2/pdf/ngeo2041.pdf},
volume = {7},
year = {2014}
}
