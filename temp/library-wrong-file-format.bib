journal = {Management Science},
keywords = {AUCTIONS,BUNDLING (Marketing),CONSUMER goods,CONSUMERS' preferences,MONOPOLIES,PROFIT maximization,Tails,Vickrey auction,heavy-tailed valuations,multiproduct monopolist,optimal bundling strategies,profit-maximizing prices},
mendeley-tags = {Tails},
number = {11},
pages = {1963--1976},
