@article{Landsberger1990,
abstract = {A characterization of comparative risk, parallel to but more restrictive than the Rothschild-Stiglitz (1970) characterization, is developed. As in Rothschild and Stiglitz, we develop a four-way characterization that consists of generating processes (a noise condition and generation by a sequence of special mean-preserving spreads), integral conditions, and preferences. The building blocks of this new order, Mean-preserving increases in risk about $\nu$, where $\nu$ is any constant, are mean-preserving spreads whose centers have a nonempty intersection. If this intersection contains the mean of the distribution, the induced order, or mean-preserving increase in risk about the mean, conveys a particularly meaningful notion of an increase in risk as a buildup of the tails of the distribution. {\textcopyright} 1990 Kluwer Academic Publishers.},
author = {Landsberger, Michael and Meilijson, Isaac},
doi = {10.1007/BF00213261},
file = {:C\:/Users/steve/MendeleyLibrary/Landsberger, Meilijson/1990 - Landsberger, Meilijson - A tale of two tails An alternative characterization of comparative risk.pdf:pdf},
issn = {08955646},
journal = {Journal of Risk and Uncertainty},
keywords = {mean-preserving spreads,risk,star-shape,uncertainty},
number = {1},
pages = {65--82},
title = {{A tale of two tails: An alternative characterization of comparative risk}},
volume = {3},
year = {1990}
}
