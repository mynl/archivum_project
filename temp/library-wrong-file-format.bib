@article{Espinoza2009,
abstract = {We show, in a monetary exchange economy, that asset prices in a complete\nmarkets general equilibrium are a function of the supply of liquidity by the Central\nBank, through its effect on default and interest rates. Two agents trade goods and nominal assets to smooth consumption across periods and future states, in the presence\nof cash-in-advance ?nancing costs that have effects on real allocations. We show that\nhigher spot interest rates reduce trade and as a result increase state prices. Hence, states\nof nature with higher interest rates are also states of nature with higher risk-neutral probabilities. This result, which cannot be found in a Lucas-type representative agent\nmodel, implies that the yield curve is upward sloping in equilibrium, even when shortterm interest rates are fairly stable and the variance of the (macroeconomic) stochastic\ndiscount factor is 0. The risk-premium in the term structure is, therefore, a monetarycost risk premium.},
author = {Espinoza, Raphael A and Goodhart, Charles and Tsomocos, Dimitrios P},
doi = {10.1007/s00199-008-0343-y},
file = {:C\:/Users/steve/MendeleyLibrary/Espinoza, Goodhart, Tsomocos/2009 - Espinoza, Goodhart, Tsomocos - State prices, liquidity, and default.pdf:pdf},
issn = {0938-2259},
journal = {Economic theory},
number = {2},
