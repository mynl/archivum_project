file = {:C\:/Users/steve/MendeleyLibrary/Zhou et al/2015 - Zhou et al. - Deep Recurrent Models with Fast-Forward Connections for Neural Machine Translation.pdf:pdf},
title = {{Deep Recurrent Models with Fast-Forward Connections for Neural Machine Translation}},
volume = {5},
year = {2015}
}
