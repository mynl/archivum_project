keywords = {Diversification,Domain of attraction of stable distributions,Heavy-tailed risks,Local and moderate deviations,Nonlinear transformations,Pareto-type distributions,Portfolios,Power laws,Risk bounds,Riskiness,Tails,Value at risk},
