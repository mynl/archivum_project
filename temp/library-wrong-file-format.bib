@article{Donoho2006a,
abstract = {We consider linear equations y = $\Phi$x where y is a given vector in ℝn and $\Phi$ is a given n × m matrix with n < m ≤ $\tau$n, and we wish to solve for x ∈ ℝm. We suppose that the columns of $\Phi$ are normalized to the unit [MATHEMATICAL SCRIPT SMALL L]2-norm, and we place uniform measure on such $\Phi$. We prove the existence of $\rho$ = $\rho$($\tau$) > 0 so that for large n and for all $\Phi$'s except a negligible fraction, the following property holds: For every y having a representation y = $\Phi$x0by a coefficient vector x0 ∈ ℝmwith fewer than $\rho$ {\textperiodcentered} n nonzeros, the solution x1of the [MATHEMATICAL SCRIPT SMALL L]1-minimization problem equation image is unique and equal to x0. In contrast, heuristic attempts to sparsely solve such systems—greedy algorithms and thresholding—perform poorly in this challenging setting. The techniques include the use of random proportional embeddings and almost-spherical sections in Banach space theory, and deviation bounds for the eigenvalues of random Wishart matrices.},
author = {Donoho, David L.},
