title = {{Estimating the relation between digitalization and the market value of insurers}},
volume = {88},
year = {2021}
}
@article{Marshall1995,
abstract = {Many connections between geometric and exponential distributions are known. Characterizations and derivations of these distributions often run parallel. Moreover, one kind of distribution can be derived from the other: exponential distributions are limits of sequences of rescaled geometric distributions, and the integral parts of exponential random variables have geometric distributions. The lack of memory property is expressed by functional equations of the form F(x + u) = F(x) F(u) for all (x, u) ∈ S, where F(x) = P{X1 > x1, {\ldots}, Xn > xn}. With S = R2n+, the equation expresses a complete lack of memory that is possessed only by distributions with independent exponential marginals. But when S is a proper subset of R2n+, the functional equation expresses a partial lack of memory property that in some cases is possessed by a more interesting family of multivariate exponential distributions, as for example, those with exponential minima. In this paper appropriate choices for S and the resulting families of solutions are investigated, together with the associated families of multivariate geometric distributions. {\textcopyright} 1995 Academic Press, Inc.},
author = {Marshall, Albert W. and Olkin, Ingram},
doi = {10.1006/jmva.1995.1027},
file = {:C\:/Users/steve/MendeleyLibrary/Marshall, Olkin/1995 - Marshall, Olkin - Multivariate exponential and geometric distributions with limited memory.pdf:pdf},
issn = {10957243},
journal = {Journal of Multivariate Analysis},
keywords = {Characterization of distributions,Functional equations,Multivariate exponential distributions,Multivariate geometric distributions},
number = {1},
pages = {110--125},
title = {{Multivariate exponential and geometric distributions with limited memory}},
volume = {53},
year = {1995}
}
@article{Lin2014,
abstract = {This article investigates the role of reinsurance networks in an insurer's\nreinsurance purchase decision. Drawing on network theory, we develop a\nframework that delineates how the pattern of linkages among reinsurers determines\nthree reinsurance costs (loadings, contagion costs, and search and\nmonitoring costs) and characterizes an insurer's optimal network structure.\nConsistent with empirical evidence based on longitudinal data from the U.S.\nproperty and casualty insurance industry, our model predicts an inverted\nU-shaped relationship between the insurer's optimal percentage of reinsurance\nceded and the number of its reinsurers. Moreover, we find that a linked\nnetwork may be optimal ex ante even though linkages among reinsurers may\nspread financial contagion, supporting the model's prediction regarding social\ncapital benefits associated with network cohesion. Our theoretical model\nand empirical results have implications for other networks such as loan sale\nmarket networks and over-the-counter dealer networks.},
author = {Lin, Yijia and Yu, Jifeng and Peterson, Manferd O},
doi = {10.1111/jori.12032},
file = {:C\:/Users/steve/MendeleyLibrary/Lin, Yu, Peterson/2014 - Lin, Yu, Peterson - Reinsurance Networks and Their Impact on Reinsurance Decisions Theory and Empirical Evidence.pdf:pdf},
issn = {1539-6975},
journal = {Journal of Risk and Insurance},
number = {August 2013},
pages = {1--39},
title = {{Reinsurance Networks and Their Impact on Reinsurance Decisions: Theory and Empirical Evidence}},
volume = {forthcomin},
year = {2014}
}
