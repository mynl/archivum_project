keywords = {PMIR,asymptotic fairness,backtesting capital,capital allocation,euler principle,expected shortfall,fair capital allocation,risk measures,tail-value-at-risk,value-at-risk},
mendeley-tags = {PMIR},
title = {{Fair Capital Risk Allocation}},
url = {http://arxiv.org/abs/1902.10044},
year = {2019}
}
