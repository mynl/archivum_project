isbn = {0378-4266},
issn = {03784266},
journal = {Journal of Banking and Finance},
keywords = {Coherence,Expected shortfall,Risk Measures,Risk contribution,Spectral risk measure,Value-at-risk},
mendeley-tags = {Risk Measures},
number = {7},
pages = {1519--1533},
