@article{Tan1999,
abstract = {In the Auroral Cluster Observation System proposed by NASA for scientific data collection, the constellation with a constant separation between adjacent satellites in an elliptical orbit is required. A novel idea for maintaining constant separation between satellites is developed. The daughter satellite orbit is changed in two steps: 1. A small angle in-plane shift (can reduce the separation distance error from +/-25% to +/-2.4%; this strategy was discussed previously); 2. A slewing around the major axis (can further reduce the separation error to +/-0.45%). The formula for determining the magnitude of the angles of shift and slewing is given in this paper, and the method for calculating the equivalent osculating orbital elements after the shift and slewing are also described. Simulations are conducted by MATLAB and the BG14 orbital propagator; the latter treats non-Kepterian type perturbations.},
