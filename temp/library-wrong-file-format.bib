@article{Vinogradov2013b,
abstract = {We introduce a new class of positive infinitely divisible probability laws calling them ℒ$\gamma$ distributions. Their cumulant-generating functions (cgf) are expressed in terms of the principal branch of the Lambert W function. The probability density functions (pdfs) of ℒ$\gamma$ laws are bounded resembling pdf of a L{\'{e}}vy stable distribution. The exponential dispersion model constructed starting from an ℒ $\gamma$ distribution admits the inverse Gaussian approximation. The natural exponential family constructed starting from an ℒ$\gamma$ distribution constitutes the reciprocal of the natural exponential family generated by a spectrally negative stable law with $\alpha$ = 1. We derive new results on ℒ$\gamma$ laws and the related exponential dispersion models, including their convolution and scaling closure properties. We generate another exponential dispersion model starting from an exponentially compounded ℒ$\gamma$ law. This distribution emerges in the Poisson mixture representation of a generalized Poisson law. We extend the Poisson approximation for the scaled Neyman type A exponential dispersion model. We derive saddlepoint-type approximations for some of these exponential dispersion models. The role of the Lambert W function is emphasized. {\textcopyright} 2013 Taylor & Francis Group, LLC.},
author = {Vinogradov, Vladimir},
doi = {10.1080/03610926.2011.602490},
file = {:C\:/Users/steve/MendeleyLibrary/Vinogradov/2013 - Vinogradov - Some utilizations of lambert w function in distribution theory.pdf:pdf},
issn = {03610926},
journal = {Communications in Statistics - Theory and Methods},
keywords = {Compound Poisson law,Compound exponential distribution,Convolution and scaling closure properties,Exponential dispersion model,Extreme stable law,Generalized Poisson family,Infinite divisibility,Inverse Gaussian approximation,Lambert W function,Neyman type A family,Poisson approximation,Poisson mixture,Reciprocal natural exponential families,Saddlepoint-type approximation,Unit variance function,ℒ $\gamma$ distributions},
number = {11},
pages = {2025--2043},
title = {{Some utilizations of Lambert W function in distribution theory}},
volume = {42},
year = {2013}
}
