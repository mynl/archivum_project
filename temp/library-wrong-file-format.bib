issn = {1572915X},
journal = {Extremes},
keywords = {Convex polytope,Extremal coefficient,Max-stable process,Tail correlation matrix,Tail dependence matrix,Tawn-Molchanov model},
number = {1},
pages = {121--168},
title = {{The realization problem for tail correlation functions}},
volume = {20},
year = {2017}
}
