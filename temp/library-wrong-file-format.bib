@book{Mcnichols2001,
abstract = {This paper discusses trade - os associated with three research designs commonly used in the earnings management literature : those based on aggregate accruals , those based on speci{\textregistered}c accruals and those based on the distribution of earnings after management . A key theme of the paper is that empirical procedures for aggregate accruals studies lag both our theories of incentives to manage accruals and our institutional knowledge of how accruals behave . Empirical {\textregistered}ndings suggest that aggregate accruals models that do not consider long - term earnings growth are potentially misspeci{\textregistered}ed and can result in misleading inferences about earnings management behavior . It is suggested that future progress in the earnings management literature is more likely to come from application of speci{\textregistered}c accrual and distribution - based tests than from aggregate accruals tests . {\'{O}}},
