@article{Landsman2005,
abstract = {There is a growing interest in the use of the tail conditional expectation as a measure of risk. For an institution faced with a random loss, the tail conditional expectation represents the conditional average amount of loss that can be incurred in a fixed period, given that the loss exceeds a specified value. This value is typically based on the quantile of the loss distribution, the so-called value-at-risk. The tail conditional expectation can therefore provide a measure of the amount of capital needed due to exposure to loss. This paper examines this risk measure for “exponential dispersion models”, a wide and popular class of distributions to actuaries which, on one hand, generalizes the Normal and shares some of its many important properties, but on the other hand, contains many distributions of nonnegative random variables like the Gamma and the Inverse Gaussian.},
author = {Landsman, Zinoviy and Valdez, Emiliano A.},
doi = {10.1017/S0515036100014124},
