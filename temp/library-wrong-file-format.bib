@article{Granville2006,
abstract = {This is a survey article on prime number races. Chebyshev noticed in the first half of the nineteenth century that for any given value of x, there always seem to be more primes of the form 4n+3 less than x then there are of the form 4n+1. Similar observations have been made with primes of the form 3n+2 and 3n+1, with primes of the form 10n+3/10n+7 and 10n+1/10n+9, and many others besides. More generally, one can consider primes of the form qn+a, qn+b, qn+c, >... for our favorite constants q, a, b, c, ... and try to figure out which forms are "preferred" over the others. In this paper, we describe these phenomena in greater detail and explain the efforts that have been made at understanding them.},
archivePrefix = {arXiv},
arxivId = {math/0408319},
author = {Granville, Andrew and Martin, Greg},
eprint = {0408319},
file = {:C\:/Users/steve/MendeleyLibrary/Granville, Martin/2006 - Granville, Martin - Prime Number Races.pdf:pdf},
journal = {MAA Monthly},
primaryClass = {math},
title = {{Prime Number Races}},
volume = {113},
year = {2006}
}
@article{Carr2021,
abstract = {We study an asset pricing model in which a Stochastic Discount Factor (SDF) and a growth process have independent increments and are affected by a common stochastic clock, which portraits uncertainty about jumps representing bonanzas and disasters. The stochastic clock is a strictly increasing process that includes a persistent component. The common component of the shock is meant to represent aggregated jumps, that is jumps whose drift it accumulating in time, like an integrated process. Skewness is positive if the rate of growth of bonanzas is greater than that of disasters. Positive skewness of the SDF is associated to negatively sloped zero-coupon bond term structure. For financial products whose cash flows are subject to the same stochastic clock the slope of the term structure is jointly determined by the difference between the skewness of the SDF and the covariance between the growth rate of the cash flows and of consumption (or the stochastic discount rate). Finally, the common component in the stochastic clock makes asset prices non-Markovian.},
author = {Carr, Peter and Cherubini, Umberto},
doi = {10.2139/ssrn.3995428},
file = {:C\:/Users/steve/MendeleyLibrary/Carr, Cherubini/2021 - Carr, Cherubini - Long Term Risk A Time Change Approach.pdf:pdf;:C\:/Users/steve/MendeleyLibrary/Carr, Cherubini/2021 - Carr, Cherubini - Long Term Risk A Time Change Approach(2).pdf:pdf},
journal = {SSRN Electronic Journal},
keywords = {Peters,as-,asset pricing,c18,c58,g12,jel code,paolo neri,sabrina mulinacci and leon,sociative operators,term structures,the authors would like,time change models,to thank kevin atteson},
mendeley-tags = {Peters},
pages = {1--45},
title = {{Long Term Risk: A Time Change Approach}},
year = {2021}
}
@article{Dana2004,
abstract = {In order to analyse the effect of ambiguity and uncertainty aversion on equilibrium welfare, a two period, pure exchange one good economy is considered. Agents are Choquet-expected-utility maximizers with same convex capacity and strictly concave utility index. It is proven that equilibrium is indeterminate whenever several probabilities in the core of the capacity minimize the expected value of aggregate endowment and not all agents have same expected endowments under those probabilities. It is further shown that small changes in aggregate endowment may have drastic welfare implications. A more general model is considered in the case of no aggregate uncertainty: agents have a set of priors and are uncertainty averse as modelled by Gilboa-Schmeidler [1989]. In the case of complete markets, it is shown that assets have a spread of equilibrium prices similar to the spread of no-arbitrage prices compatible with absence of arbitrage in markets with imperfections.},
author = {Dana, Rose Anne},
doi = {10.1007/s00199-003-0383-2},
file = {:C\:/Users/steve/MendeleyLibrary/Dana/2004 - Dana - Ambiguity, uncertainty aversion and equilibrium welfare.pdf:pdf},
issn = {09382259},
journal = {Economic Theory},
keywords = {Ambiguity,Equilibrium pricing,Equilibrium welfare,Risk Sharing,Uncertainty aversion},
mendeley-tags = {Risk Sharing},
number = {3},
