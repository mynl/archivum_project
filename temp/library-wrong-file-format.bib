@article{Dohrmann2017,
abstract = {\nIn the aftermath of a natural catastrophe, there is increased demand for skilled reconstruction labor, which leads to significant increases in reconstruction labor wages and hence insured losses. Such inflation effects are known as “Demand Surge” effects. It is important for insurance companies to properly account for these effects when calculating insurance premiums and determining economic capital. We propose an approach to quantifying the Demand Surge effect and present an econometric model for the effect that is based on 192 catastrophe events in the United States. Our model explains more than 75 percent of the variance of the Demand Surge effect and is thus able to identify the key drivers of the phenomenon.\n},
author = {D{\"{o}}hrmann, David and G{\"{u}}rtler, Marc and Hibbeln, Martin},
doi = {10.1111/jori.12134},
file = {:C\:/Users/steve/MendeleyLibrary/D{\"{o}}hrmann, G{\"{u}}rtler, Hibbeln/2017 - D{\"{o}}hrmann, G{\"{u}}rtler, Hibbeln - Insured Loss Inflation How Natural Catastrophes Affect Reconstruction Costs.pdf:pdf},
issn = {15396975},
journal = {Journal of Risk and Insurance},
number = {3},
