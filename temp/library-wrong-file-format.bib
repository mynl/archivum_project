issn = {08955646},
journal = {Journal of Risk and Uncertainty},
keywords = {Allais paradox,C91,D81,betweenness,disappointment-aversion,expected utility,generalized utility,prospect theory,risk-aversion},
number = {2},
pages = {167--196},
title = {{Violations of the betweenness axiom and nonlinearity in probability}},
volume = {8},
