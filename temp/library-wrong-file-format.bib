abstract = {This paper provides a theoretical analysis of the benefits for an insurance company to develop its own network of service providers when insurance fraud is characterized by collusion between policyholders and providers. In a static framework without collusion, exclusive affiliation of providers allows insurance companies to recover some market power and to lessen competition on the insurance market. This entails a decrease in the insured's welfare. However, exclusive affiliation of providers may entail a positive effect on customers' surplus when insurers and providers are engaged in a repeated relationship. In particular, while insurers must cooperate to retaliate against a fraudulent provider under non-exclusive affiliation, no cooperation is needed under exclusive affiliation. In that case, an insurer is indeed able to reduce the profit of a malevolent provider by moving to collusion-proof contracts when collusion is detected, and this threat may act as a deterrent for fraudulent activities. This possibility may supplement an inefficient judicial system: it is thus a second-best optimal anti-fraud policy. ?? 2007 Elsevier B.V. All rights reserved.},
author = {Bourgeon, Jean Marc and Picard, Pierre and Pouyet, Jerome},
doi = {10.1016/j.jbankfin.2007.09.012},
file = {:C\:/Users/steve/MendeleyLibrary/Bourgeon, Picard, Pouyet/2008 - Bourgeon, Picard, Pouyet - Providers' affiliation, insurance and collusion.pdf:pdf},
issn = {03784266},
journal = {Journal of Banking and Finance},
keywords = {Affiliation/vertical relationships,Fraud,Insurance},
number = {1},
pages = {170--186},
title = {{Providers' affiliation, insurance and collusion}},
volume = {32},
year = {2008}
}
@article{Landsman1998a,
abstract = {Abstract The Exponential Dispersion Family is a rich family of distributions, comprised of several distributions, some of which are heavy-tailed and as such could be of significant relevance to actuarial science. The family draws its richness from a dispersion parameter $\sigma$ 2 = 1/$\lambda$ which is equal to 1 in the case of the Natural Exponential Family. We consider three cases. In the first $\lambda$ is assumed known, in the second a prior distribution for $\lambda$ is given, and in the third the prior distribution of $\lambda$ is not known and is derived by means of the maximum entropy principle, assuming the prior mean of $\lambda$ can be specified. For these cases, a conjugate prior distribution for the risk parameter is assumed and credibility formulae are derived for the estimation of the fair premium.},
author = {Landsman, Zinoviy M. and Makov, Udi E.},
