journal = {SIAM Journal on Optimization},
keywords = {MATHEMATICAL optimization,PERTURBATION (Mathematics),PROBABILITY theory,RANDOM variables,Risk Measures,STOCHASTIC processes,Wasserstein and Kantorovich distance,continuity properties,optimal transport,risk measures},
