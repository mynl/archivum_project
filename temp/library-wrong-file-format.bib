issn = {09603174},
journal = {Statistics and Computing},
keywords = {Compound Poisson distributions,Gamma distribution,Generalized linear models,Inverse-Gaussian distribution,Linear exponential family,Maximum likelihood estimation,Poisson distribution,Power variance function,Stable distributions},
number = {4},
pages = {267--280},
title = {{Series evaluation of Tweedie exponential dispersion model densities}},
volume = {15},
year = {2005}
