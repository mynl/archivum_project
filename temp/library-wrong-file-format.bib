author = {Gibbs, Alison L and Su, Francis Edward},
file = {:C\:/Users/steve/MendeleyLibrary/Gibbs, Su/2018 - Gibbs, Su - On Choosing and Bounding Probability Metrics.pdf:pdf},
number = {3},
pages = {419--435},
title = {{On Choosing and Bounding Probability Metrics}},
