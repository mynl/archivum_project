doi = {10.1016/j.insmatheco.2006.04.003},
file = {:C\:/Users/steve/MendeleyLibrary/Roorda, Schumacher/2007 - Roorda, Schumacher - Time consistency conditions for acceptability measures, with an application to Tail Value at Risk.pdf:pdf},
