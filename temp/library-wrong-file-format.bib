@article{DeJarnette2018,
abstract = {We study preferences over lotteries that pay a fixed prize at an uncertain future date: what we call time lotteries. The standard model of risk and time preferences, Expected Discounted Utility, implies that individuals must be risk seeking towards such lotteries (RSTL). In contrast, we show experimentally that almost all subjects violate this property. Our main contributions are theoretical. First, we show that risk aversion over time lotteries can be captured by a generalization of Expected Discounted Utility that is obtained by keeping the behavioral postulates of Discounted Utility and Expected Utility. Second, we introduce a new property termed Stochastic Impatience, a risky counterpart of standard Impatience, and show that not only the model above, but also substantial generalizations that allow for non-Expected Utility and non-exponential discounting, cannot jointly accommodate it and even a single instance of risk aversion over time lotteries (or, equivalently, any violation of RSTL), showing a fundamental tension between the two.},
author = {DeJarnette, Patrick and Dillenberger, David and Gottlieb, Daniel and Ortoleva, Pietro},
doi = {10.2139/ssrn.3252514},
file = {:C\:/Users/steve/MendeleyLibrary/DeJarnette et al/2018 - DeJarnette et al. - Time Lotteries and Stochastic Impatience.pdf:pdf},
journal = {SSRN Electronic Journal},
keywords = {expected discounted utility,separation of risk and,stochastic impatience,time lotteries,time preferences},
title = {{Time Lotteries and Stochastic Impatience}},
